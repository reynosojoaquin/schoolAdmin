@page "/ListaEstudiantes"

@using SchoolControl.Shared;
@using SchoolControl.Client.Services;
@using CurrieTechnologies.Razor.SweetAlert2;
@using OfficeOpenXml;
@using SchoolControl.Client.Extensiones;
@inject SweetAlertService Swal;
@inject IEstudianteServices EstudianteServices;
@inject NavigationManager NavigationManager;

<div class="card-body">
    <!-- Fila para el filtro y el botón -->
    <div class="row  mb-1 border border-1 rounded p-3">
        <label class="mb-1">
            Registro masivo de Estudiantes
        </label>
        <div class="col-md-12 ">

            <label for="archivoExcel" class="btn btn-primary">
                📁 Seleccionar archivo Excel
            </label>
            <InputFile id="archivoExcel" class="d-none" OnChange="CargarArchivoExcel" accept=".xlsx" />

            @if (nombreArchivo is not null)
            {
                <p>Archivo seleccionado: <strong>@nombreArchivo</strong></p>
                <p>Total encontrados: <strong>@fileData.Count</strong></p>
            }
            <!--datos registrados en el archivo-->
            <table class="table table-striped  ">
                <thead>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>SIGERD</th>
                </thead>
                <tbody>
                    @if (fileData != null)
                    {

                        @foreach (var item in fileData)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Nombres</td>
                                <td>@item.Apellidos</td>
                                <td>@item.SigerdId</td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
        <div class="col-md-12">
            <div class="container">
                <div class="row">
                    <div class="col-md-10 text-start">
                        <button class="btn @(!fileSelected ? "btn-primary" : "btn-success")" disabled="@(!fileSelected)" @onclick="()=> registroMasivo()">
                            <i class="fas fa-save me-2"></i> Registrar
                        </button>
                        <button class="btn @(!fileSelected ? "btn-primary" : "btn-danger")" disabled="@(!fileSelected)" @onclick="()=> CancelarRegistroMasivo()">
                            <i class="fas fa-times-circle"></i> Cancelar
                        </button>
                    </div>

                </div>

            </div>


        </div>
        <div class="col-md-2">

        </div>
        <div class="col-md-2">
        </div>
    </div>

</div>
<div class="card mt-6">
    <div class="card-header">
        <h3 class="card-title">Estudiantes </h3>
    </div>
    <div class="card-body">
        <div class="container mt-2">
            <!-- Fila para el filtro y el botón -->
            <div class="row mb-1">
                <div class="col-md-3 text-start">

                    <button class="btn btn-primary" @onclick="()=> showCreatePage(0)">
                        <i class="fas fa-plus"></i> Añadir Nuevo
                    </button>
                </div>
                <div class="col-md-9">
                    <!-- Campo para filtrar datos -->
                    <input type="text" @bind-value="searchTerm" @onkeypress="OnKeyPress" id="filterInput" class="form-control" placeholder="Filtrar Estudiantes...">
                </div>

            </div>
        </div>

        <table class="table table-striped  ">
            <thead>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>SIGERD</th>
                <th>Acciones</th>
            </thead>
            <tbody>
                @if (EstudiantesFiltrados == null)
                {
                    <tr>
                        <td colspan="5" align="center">
                            <img style="with:50px" src="https://media.tenor.com/2BLI5EO7yVAAAAAi/loading-image.gif" />
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in EstudiantesFiltrados)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombres</td>
                            <td>@item.Apellidos</td>
                            <td>@item.SigerdId</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="(()=> Modificar(item.Id))" href="addEstudiantes/@item.Id">
                                    <i class="fas fa-edit"></i> Editar
                                </button>
                                <button class="btn btn-sm btn-info" @onclick="(()=> MostrarInfoEstudiante(item.Id))">
                                    <i class="fas fa-info-circle"></i>&nbspInformacion
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="(()=> eliminar(item.Id))">
                                    <i class="fas fa-trash-alt"></i>&nbspEliminar
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>




@code {
    public string searchTerm = string.Empty;
    List<EstudiantesDTO>? Estudiantes = null;
    List<EstudiantesDTO>? EstudiantesFiltrados = null;
    List<EstudiantesDTO>? EstudiantesArchivo = null;
    [Parameter]
    public bool showFirstPage { get; set; }
    [Parameter]
    public EventCallback<string> OnValueSentBack { get; set; }
    public int user_id { get; set; }
    private bool fileSelected = false;
    private bool addSection = false;
    private string? mensaje;
    private IBrowserFile archivo;
    private string nombreArchivo;
    private List<EstudiantesDTO> fileData = new List<EstudiantesDTO>();
    protected override async Task OnInitializedAsync()
    {
        await cargarEstudiantes();

    }
    private async Task cargarEstudiantes()
    {
        Estudiantes = await EstudianteServices.Lista(0);
        EstudiantesFiltrados = Estudiantes;
    }
    private async Task FiltrarEstudiantes()
    {
        EstudiantesFiltrados = Estudiantes.Where(e => e.Nombres.ToLower().Contains(searchTerm.ToLower())).ToList();

    }
    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        // Filtrar cuando se presione "Enter"
        if (e.Key == "Enter")
        {
            await FiltrarEstudiantes();
        }
    }
    private async Task eliminar(int id)
    {
        var resultado = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Eliminar Estudiantes",
                Text = "Deseas eliminar el Estudiante",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (resultado.IsConfirmed)
        {
            var eliminado = await EstudianteServices.Eliminar(id);
            if (eliminado)
                Estudiantes = Estudiantes.FindAll(e => e.Id != id);
        }
    }
    private async Task Modificar(int id)
    {
        showCreatePage(id);
    }
    public void showCreatePage(int value)
    {
        SendBackValue("ADD," + Convert.ToString(value));
    }
    public void SendBackValue(string value)
    {
        OnValueSentBack.InvokeAsync(value);
    }
    private void CalificarEstudiantes(int id)
    {
        NavigationManager.NavigateTo("/Calificaciones");
    }
    private async Task CargarArchivoExcel(InputFileChangeEventArgs e)
    {
        archivo = e.File;
        if (archivo is null || archivo.ContentType != "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
        {
            mensaje = "Por favor, seleccione un archivo .xlsx válido.";
            return;
        }
        fileSelected = true;
        nombreArchivo = e.File.Name;

        EPPlusLicense ePPlusLicense = new EPPlusLicense();
        ePPlusLicense.SetNonCommercialPersonal("RTFD");
        try
        {
            using var stream = e.File.OpenReadStream();
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            using var package = new ExcelPackage(ms);
            var worksheet = package.Workbook.Worksheets[0];
            var rowCount = worksheet.Dimension.Rows;

            var estudiantes = new List<EstudiantesDTO>();
            for (int row = 2; row <= rowCount; row++)
            {
                try
                {
                    var value = worksheet.Cells[row, 1].Value?.ToString();
                    if (value != null)
                    {
                        estudiantes.Add(new EstudiantesDTO
                            {
                                Nombres = worksheet.Cells[row, 1].Value?.ToString(),
                                Apellidos = worksheet.Cells[row, 2].Value?.ToString(),
                                Cedula = worksheet.Cells[row, 3].Value?.ToString(),
                                Sexo = worksheet.Cells[row, 4].Value?.ToString(),
                                FechaNacimiento = worksheet.Cells[row, 5].Value?.ToString(),
                                SigerdId = worksheet.Cells[row, 6].Value?.ToString(),
                            });
                    }

                }
                catch (Exception ex)
                {

                }
            }
            fileData = estudiantes;
            StateHasChanged();
        }
        catch (Exception exe)
        {

        }

    }
    private async Task registroMasivo()
    {
        var resultado = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Carga masiva de estudiantes",
                Text = "Deseas cargar datos masivos de estudiantes",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (resultado.IsConfirmed)
        {


            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // 10MB
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivo.ContentType);
            content.Add(content: fileContent, name: "\"file\"", fileName: archivo.Name);
            var registrados = await EstudianteServices.RegistroMasivo(content);
            if (registrados)
            {
                var result = await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Carga masiva de Estudiantes",
                        Text = "Datos cargados satisfactoriamente",
                        Icon = SweetAlertIcon.Info,
                        ShowCancelButton = false
                    });
                await  CancelarRegistroMasivo();
                await cargarEstudiantes();
            }

        }
    }
    private async Task CancelarRegistroMasivo()
    {
        fileData.Clear();
        nombreArchivo = "";
        fileSelected = false;
        StateHasChanged();
    }
    private async Task MostrarInfoEstudiante(int id)
    {
        SendBackValue("INFO," + Convert.ToString(id));
    }
}
<style>
     .col-id {
        width: 100px; /* Ajusta este valor según el tamaño del contenido de la columna Id */
        text-align: center;
    }

    .col-nombre {
        width: 1px; /* Ajuste inicial para que tome el espacio restante */
        white-space: nowrap; /* Evita el ajuste de línea en el contenido */
    }
</style>