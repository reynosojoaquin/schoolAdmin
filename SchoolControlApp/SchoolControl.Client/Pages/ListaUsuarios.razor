@page  "/ListaUsuarios"

@using SchoolControl.Shared;
@using SchoolControl.Client.Services;
@using CurrieTechnologies.Razor.SweetAlert2;

@inject SweetAlertService Swal;
@inject IUserService UserServices;
@inject NavigationManager NavigationManager
<div class="card mt-12">
    <div class="card-header">
        <h3 class="card-title">USUARIOS</h3>
    </div>
    <div class="card-body">
        <div class="container mt-2">
            <!-- Fila para el filtro y el botón -->
            <div class="row mb-1">
                <div class="col-md-4 text-start">

                    <button class="btn btn-primary" @onclick="()=> showCreatePage(0)">
                        <i class="fas fa-plus"></i> Añadir Nuevo Usuario
                    </button>
                </div>
                <div class="col-md-8">
                    <!-- Campo para filtrar datos -->
                    <input type="text" @bind-value="searchTerm" @onkeypress="OnKeyPress" id="filterInput" class="form-control" placeholder="Filtrar Usuarios...">
                </div>

            </div>
        </div>

        <table class="table table-striped  ">
            <thead>
            <th>Id</th>
            <th>Nombre</th>
            <th>Rol</th>
            <th>Acciones</th>
            </thead>
            <tbody>
                @if (ListUsuarios == null)
                {
                    <tr>
                        <td colspan="5" align="center">
                            <img style="with:50px" src="https://media.tenor.com/2BLI5EO7yVAAAAAi/loading-image.gif" />
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in ListUsuarios)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Fullname</td>
                            <td>@item.role.NombreRol</td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="(()=> Modificar(item.Id))" >
                                    <i class="fas fa-edit"></i>&nbsp Editar
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="(()=> eliminar(item.Id))">
                                    <i class="fas fa-trash-alt"></i>&nbspEliminar
                                </button>
                             </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>




