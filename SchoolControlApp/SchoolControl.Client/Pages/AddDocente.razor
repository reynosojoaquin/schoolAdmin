@page "/AddDocente/{id}"
@using SchoolControl.Shared;
@using SchoolControl.Client.Services;
@using CurrieTechnologies.Razor.SweetAlert2;
@using BlazorInputMask;
@using System.Globalization;
@inject HttpClient Http;
@inject SweetAlertService Swal;
@inject IDocentesServices DocenteServices;
@inject ILugarNacimientoServices LugarNacimientoServices;
@inject INacionalidadServices NacionalidadServices;
@inject IHistoriaClinicaServices HistoriaClinicaServices;   
@inject NavigationManager navegacion;

<div class="card mt-4">
    <div class="card-header">
        <h3 class="card-title">@titulo</h3>
    </div>
    <div class="card-body">

        <!-- Nav Tabs -->
        <ul class="nav nav-tabs" id="studentTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="docente-tab" data-bs-toggle="tab" data-bs-target="#docente" type="button" role="tab" aria-controls="docente" aria-selected="true">
                    <i class="fas fa-user-graduate"></i> Docente
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tutor-tab" data-bs-toggle="tab" data-bs-target="#academico" type="button" role="tab" aria-controls="acadecmico" aria-selected="false">
                    <i class="fas fa-book"></i> Formacion academica
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="medica-tab" data-bs-toggle="tab" data-bs-target="#medica" type="button" role="tab" aria-controls="medica" aria-selected="false">
                    <i class="fas fa-notes-medical"></i> Historia Clinica
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content p-4 border border-top-0 shadow-sm" id="studentTabContent">
            <!-- Docente -->
            <div class="tab-pane fade show active" id="docente" role="tabpanel" aria-labelledby="docente-tab">
                <h5><i class="fas fa-user-graduate text-primary"></i> Información del Docente</h5>
                <EditForm Model="docente">
                    <DataAnnotationsValidator />
                    <div class="container mt-4 mb-4">
                        <div class="row">
                            <div class="col-8">
                                <div class="row">
                                    <!-- Nombres -->
                                    <div class="col-md-8">
                                        <label class="form-label">Nombres</label>
                                        <InputText class="form-control" @bind-Value="docente.Nombres" />
                                    </div>
                                </div>

                                <div class="row">
                                    <!-- Apellidos -->
                                    <div class="col-md-8">
                                        <label class="form-label">Apellidos</label>
                                        <InputText class="form-control" @bind-Value="docente.Apellido" />
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Cédula -->
                                    <div class="col-md-8">
                                        <label class="form-label">Cédula</label>
                                        <InputText class="form-control" @bind-Value="docente.Cedula" />
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Correo -->
                                    <div class="col-md-8">
                                        <label class="form-label">Correo</label>
                                        <InputText type="email" class="form-control" @bind-Value="docente.Correo" />
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Sexo -->
                                    <div class="col-md-8">
                                        <label class="form-label">Sexo</label>
                                        <InputSelect class="form-select" @bind-Value="docente.Sexo">
                                            <option value="">Seleccione</option>
                                            <option value="M">Masculino</option>
                                            <option value="F">Femenino</option>
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Nacionalidad -->
                                    <div class="col-md-8">
                                        <label class="form-label">Nacionalidad</label>
                                        <InputSelect class="form-select" @bind-Value="docente.Nacionalidad">
                                            <option value="0">Seleccionar</option>
                                            @foreach (var item in nacionalidades)
                                            {
                                                <option value="@item.Id">@item.Nombre</option>
                                            })
                                            <option value="@nacionalidades.Count++">Otra</option>
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Lugar de Nacimiento -->
                                    <div class="col-md-8">
                                        <label class="form-label">Lugar de Nacimiento</label>
                                        <InputSelect class="form-select" @bind-Value="docente.LugarNacimiento">
                                            <option value="0">Seleccionar</option>
                                            @foreach (var item in lugaresNacimiento)
                                            {
                                                <option value="@item.Id">@item.Nombre</option>
                                            })
                                            <option value="@lugaresNacimiento.Count++">Otro</option>

                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Fecha de Nacimiento -->
                                    <div class="col-md-8">
                                        <label class="form-label">Fecha de Nacimiento</label>
                                        <InputDate class="form-control"
                                        @bind-Value="fechaNacimiento" />
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- FECHA DE INGRESO -->
                                    <div class="col-md-8">
                                        <label class="form-label">Fecha de Ingreso</label>
                                        <InputDate class="form-control" @bind-Value="fechaIngreso" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <label for="fileInput" class="btn btn-success">
                                    <i class="nav-icon fas fa-camera"></i>
                                    Seleccionar imagen
                                </label>
                                <InputFile id="fileInput" class="d-none" OnChange="OnFileChange" accept="image/*" />
                                <br />
                                @if (!string.IsNullOrEmpty(ImagePreview))
                                {
                                    <img src="@ImagePreview" alt="Vista previa" class="img-thumbnail" style="max-width: 200px; max-height: 200px;border:thick" />
                                }

                            </div>
                        </div>

                    </div>
                    <ValidationSummary />
               </EditForm>
            </div>
            <!--FORMACION ACADEMICA-->
            <div class="tab-pane fade" id="academico" role="tabpanel" aria-labelledby="academico-tab">
                <h5><i class="fas fa-book"></i> Formacion academica</h5>
               

            </div>
            <!-- Historia Médica -->
            <div class="tab-pane fade" id="medica" role="tabpanel" aria-labelledby="medica-tab">
                <h5><i class="fas fa-notes-medical text-danger"></i> Historia Médica</h5>
                <EditForm Model="@nuevoHistorial" OnValidSubmit="AgregarEntradaHistorial">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row g-3">
                        <!-- Selector de Tipo -->
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label class="form-label">Tipo de Registro:</label>
                                <InputSelect @bind-Value="nuevoHistorial.Tipo" class="form-select">
                                    <option value="">Seleccionar tipo...</option>
                                    <option value="Enfermedad">Enfermedad</option>
                                    <option value="Alergia">Alergia</option>
                                    <option value="Medicamento">Medicamento</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => nuevoHistorial.Tipo)" />
                            </div>
                        </div>

                        <!-- Campo Descripción -->
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label">Descripcion</label>
                                <InputTextArea @bind-Value="nuevoHistorial.Descripcion" class="form-control"
                                rows="3"  />
                                <ValidationMessage For="@(() =>nuevoHistorial.Descripcion)" />
                            </div>
                        </div>

                        <!-- Botón de Agregar -->
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus-circle"></i> Agregar Registro
                            </button>

                        </div>
                        <hr />

                        <h4 class="mt-4">Historia clinica Registrada</h4>

                        @if (historiaClinica.Count == 0)
                        {
                            <div class="alert alert-info">No hay historia registrada aún.</div>
                        }
                        else
                        {
                            <table class="table table-bordered table-striped mt-3">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Tipo</th>
                                        <th>Descripcion</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var historia in historiaClinica)
                                    {
                                        <tr>
                                            <td>@(historiaClinica.IndexOf(historia) + 1)</td>
                                            <td>@historia.Tipo</td>
                                            <td>@historia.Descripcion</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" @onclick="(()=> eliminaHistorial(historia.Id))">
                                                    <i class="fas fa-trash-alt"></i>&nbspEliminar
                                                </button>   
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }


                    </div>
                </EditForm>

            </div>
           
        </div>
        <br />
        <div class="mb-3">
            <button type="button" class="btn btn-primary me-2" @onclick="HandleValidSubmit">
                <i class="nav-icon fas fa-save"></i> Guardar
            </button>
            <button type="button" class="btn btn-secondary" @onclick="HandleCancel">
                <i class="nav-icon fas fa-window-close"></i> Cancelar
            </button>
        </div>


    </div>
</div>




@code {
    [Parameter]
    public EventCallback<string> OnValueSentBack { get; set; }
    [Parameter]
    public int id { get; set; } = 0;
    string titulo = string.Empty;
    string btnTexto = string.Empty;
    List<NacionalidadDTO> nacionalidades = new List<NacionalidadDTO>();
    List<LugarNacimientoDTO> lugaresNacimiento = new List<LugarNacimientoDTO>();    
    DateTime  fechaNacimiento = DateTime.Now;
    DateTime fechaIngreso = DateTime.Now;
    List<HistoriaClinicaDTO> historiaClinica = new List<HistoriaClinicaDTO>();
    DocenteDTO docente = new DocenteDTO
    {
        Nombres = "",
        Apellido = "",
        Cedula = "",
        Correo = "",
        Sexo = "",
        Url = "",
        Nacionalidad = 0,
        LugarNacimiento = 0,
        FechaIngreso = DateTime.Now.ToShortDateString(),
        FechaNacimiento = DateTime.Now.ToShortDateString(),
        ObjLugarNacimiento = new(),
        ObjNacionalidad    = new() 

    };
    private IBrowserFile selectedFile;
    private string ImagePreview;
    private bool IsUploading = false;

    private HistoriaClinicaDTO nuevoHistorial = new HistoriaClinicaDTO();

    protected override async Task OnInitializedAsync()
    {
        lugaresNacimiento = await LugarNacimientoServices.Lista(0); 
        nacionalidades = await NacionalidadServices.Lista(0);

        if (id != 0)
        {
            docente = await DocenteServices.GetDocenteByIdAsync(id);

            fechaNacimiento = DateTime.TryParseExact(docente.FechaNacimiento,
                           "yyyy-MM-dd",
                           CultureInfo.InvariantCulture,
                           DateTimeStyles.None,
                           out var fechaNacTemp)
                           ? fechaNacTemp
                           : DateTime.Now;

            fechaIngreso = DateTime.TryParseExact(docente.FechaIngreso,
                "yyyy-MM-dd",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out var fechaInTemp) 
            ? fechaInTemp 
            : DateTime.Now;


            if (!string.IsNullOrEmpty(docente.Url))
            {
                ImagePreview = docente.Url;
            }
            // foreach(HistoriaClinicaDTO historia in docente.objHistoriasClinicas)
            // { 
            //     historiaClinica.Add( new HistoriaClinicaDTO
            //     {
            //         Descripcion = historia.Descripcion,
            //         DocenteId = historia.DocenteId,
            //         Id           = historia.Id,
            //         Tipo         = historia.Tipo
            //     });

            // }
            // foreach (PadresDTO padre in docente.Padres)
            // {
            //     tutoresRegistrados.Add(new PadresDTO
            //         {
            //             Nombre = padre.Nombre,
            //             Apellido = padre.Apellido,
            //             Parentesco = padre.Parentesco,
            //             Telefono = padre.Telefono,
            //             Id       = padre.Id,
            //             DocenteId = padre.DocenteId
            //         });
            // }

            btnTexto = "Actualizar Docente";
            titulo = "Editar Docente";
        }
        else
        {
            docente.Nombres = "";
            btnTexto = "Guardar Docente";
            titulo = "Nuevo Docente";
        }
    }

    public void respuesta()
    {
        SendBackValue("false,En");
    }
    public void SendBackValue(string value)
    {
        OnValueSentBack.InvokeAsync(value);
    }
    private void HandleCancel()
    {
        SendBackValue(",p,0");
    }
    private async Task HandleValidSubmit()
    {

        int idDevuelto = 0;
        if (id == 0)
        {
            try
            {
                docente.FechaNacimiento = fechaNacimiento.ToShortDateString();
                docente.FechaIngreso = fechaIngreso.ToShortDateString();
                docente.Url = ImagePreview;
                // docente.Padres = tutoresRegistrados;
                // docente.HistoriasClinicas = historiaClinica;

                id = await DocenteServices.Guardar(docente);
                HandleCancel();
            }
            catch(Exception ex)
            {
                await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Success);
            }        

        }
        else
        {


            docente.FechaNacimiento = fechaNacimiento.ToShortDateString();
            docente.FechaIngreso = fechaIngreso.ToShortDateString();
            docente.Url = ImagePreview;
            // docente.Padres = tutoresRegistrados;
            // docente.HistoriasClinicas = historiaClinica;

            docente.Url = ImagePreview;
            try
            {
                EditDocenteDTO editDo = new EditDocenteDTO
                {
                    Id = docente.ID,
                    Nombres = docente.Nombres,
                    Apellidos = docente.Apellido,
                    Cedula = docente.Cedula,
                    Correo = docente.Correo,
                    Sexo = docente.Sexo,
                    NacionalidadId = docente.Nacionalidad,
                    LugarNacimientoId = docente.LugarNacimiento,
                    FechaNacimiento = DateOnly.FromDateTime(fechaNacimiento),
                    FechaIngreso =    DateOnly.FromDateTime(fechaIngreso),
                    Url = docente.Url,
                    Activo = docente.Activo,
                    Direccion = docente.Direccion,
                    EstadoCivil = docente.EstadoCivil,  
                    Licencia    = docente.Licencia,
                    Telefono    = docente.Telefono,
                    Userid      = 0 
                };
                idDevuelto = await DocenteServices.UpdateDocenteAsync(editDo);
                HandleCancel();
            }catch(Exception ex)
            {
                await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Success);
            }


        }




        if (idDevuelto != 0)
        {
            HandleCancel();
            // navegacion.NavigateTo("/Provincia");
        }

    }
    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        // Crear vista previa de la imagen
        var buffer = new byte[selectedFile.Size];
        await selectedFile.OpenReadStream().ReadAsync(buffer);
        ImagePreview = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }
    private async Task UploadImage()
    {
        if (selectedFile is null) return;

        IsUploading = true;

        var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(selectedFile.OpenReadStream(selectedFile.Size));
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);

        content.Add(fileContent, "file", selectedFile.Name);

        var response = await Http.PostAsync("https://localhost:5001/api/upload", content);
        IsUploading = false;

        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Imagen subida correctamente");
        }
        else
        {
            Console.WriteLine("Error al subir la imagen");
        }
    }
  
    public async Task AgregarEntradaHistorial()
    {
        historiaClinica.Add(nuevoHistorial);
        nuevoHistorial = new HistoriaClinicaDTO();
        await Swal.FireAsync("Éxito", "Historial agregado correctamente.", SweetAlertIcon.Success);
    }
   
    private async Task  eliminaHistorial(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¿Está seguro?",
                Text = "¿Desea eliminar este registro?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, eliminar",
                CancelButtonText = "Cancelar"
            });
        if (result.IsConfirmed)
        {
            try{
               
                try
                {
                   // await HistoriaClinicaServices.Eliminar(id);
                    var historia = historiaClinica.FirstOrDefault(h => h.Id == id);
                    if (historia != null)
                    {
                        historiaClinica.Remove(historia);
                    };
                
                }
                catch (Exception ex)
                {
                    await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
                }
               
            }
            catch (Exception ex)
            {
                await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
            }
            await Swal.FireAsync("Eliminado", "El registro ha sido eliminado.", SweetAlertIcon.Success);
        }
    }
}
