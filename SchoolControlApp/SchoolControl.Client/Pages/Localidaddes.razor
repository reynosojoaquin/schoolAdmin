@page "/Localidades"
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Components.Authorization;
@attribute [Authorize]
@using SchoolControl.Client.Pages;
<h3>Localidades</h3>
<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-edit"></i>
           Configuracion general de las localidades
        </h3>
    </div>
    <div class="card-body">
        <h4>Opciones</h4>
        <div class="row">
            <div class="col-5 col-sm-3">
                <div class="nav flex-column nav-tabs h-100" id="vert-tabs-tab" role="tablist" aria-orientation="vertical">
                    <a class="nav-link active" id="vert-tabs-provincia-tab" data-bs-toggle="pill" href="#vert-tabs-provincia" role="tab" aria-controls="vert-tabs-provincia" aria-selected="true">Provincias</a>
                    <a class="nav-link" id="vert-tabs-ciudad-tab" data-bs-toggle="pill" href="#vert-tabs-ciudad" role="tab" aria-controls="vert-tabs-ciudad" aria-selected="false">Ciudades</a>
                    <a class="nav-link" id="vert-tabs-sector-tab" data-bs-toggle="pill" href="#vert-tabs-sector" role="tab" aria-controls="vert-tabs-sector" aria-selected="false">Sectores</a>
      
                </div>
            </div>
            <div class="col-7 col-sm-9">
                <div class="tab-content" id="vert-tabs-tabContent">
                    <div class="tab-pane fade show active" id="vert-tabs-provincia" role="tabpanel" aria-labelledby="vert-tabs-provincia-tab">
                        @if (showIndexProvincia)
                        {
                            <Provincia OnValueSentBack="ReceiveValue" />
                        }
                        else
                        {
                            <CreateProvincia id="@provinciaID" OnValueSentBack="ReceiveValue" />
                           
                        }
                    </div>
                    <div class="tab-pane fade" id="vert-tabs-ciudad" role="tabpanel" aria-labelledby="vert-tabs-ciudad-tab">
                        @if (showIndexCiudad)
                        {
                            <Ciudad OnValueSentBack="ReceiveValue" />
                        }
                        else
                        {
                            <CreateCiudad id="@ciudadID" OnValueSentBack="ReceiveValue" />

                        }
                    </div>
                    <div class="tab-pane fade" id="vert-tabs-sector" role="tabpanel" aria-labelledby="vert-tabs-sector-tab">
                        @if (showIndexSector)
                        {
                            <Sector OnValueSentBack="ReceiveValue" />
                        }
                        else
                        {
                            <CreateSector id="@SectorID" OnValueSentBack="ReceiveValue" />

                        }
                    </div>
                </div>
            </div>
        </div>
    
    </div>
    <!-- /.card -->
</div>
@code {
    private int provinciaID = 0;
    private int ciudadID = 0;
    private int SectorID = 0;
    private bool showIndexProvincia = true;
    private bool showIndexCiudad = true;
    private bool showIndexSector = true;
    private string receivedValue = string.Empty;
    public string titulo = "";
    private void TogglePageProvincia(string value)
    {

        showIndexProvincia = !Convert.ToBoolean(value); ;

    }
    private void TogglePageCiudad(string value)
    {

        showIndexCiudad = !Convert.ToBoolean(value); ;

    }
    private void TogglePageSector(string value)
    {

        showIndexSector = !Convert.ToBoolean(value); ;

    }
    private void ReceiveValue(string value)
    {
        string[] valores = value.Split(',');
        string opcion =valores[1];
        if(opcion == "p")
        {

            string val1 = valores[0];
            string val2 = valores[2];
            TogglePageProvincia(val1);
            provinciaID = Convert.ToInt32(val2);
        }
        if (opcion == "c")
        {

            string val1 = valores[0];
            string val2 = valores[2];
            TogglePageCiudad(val1);
            ciudadID = Convert.ToInt32(val2);
        }

        if (opcion == "s")
        {
            
            string val1 = valores[0];
            string val2 = valores[2];
            TogglePageSector(val1);
            SectorID = Convert.ToInt32(val2);
        }
    }
}
