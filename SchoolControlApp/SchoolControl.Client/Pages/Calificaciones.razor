    private async Task registrarDatos()
    {
        var resultado = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Registrando las calificaciones",
                Text = "Deseas registrar los datos de las calificiaciones",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (resultado.IsConfirmed)
        {
            try
            {
                var calificacionesRegistered = await calificacionesService.Editar(calificacionesData.GetCalificiones(calificacionesData));
                resultado = await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Registrando las Calificaciones",
                        Text = "Datos registrados Con exito",
                        Icon = SweetAlertIcon.Success,
                        ShowCancelButton = false
                    });
            }
            catch(Exception e)
            {
                resultado = await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Registrando las Calificaciones",
                        Text = $"Error al registrar los datos [{e.Message}]",
                        Icon = SweetAlertIcon.Success,
                        ShowCancelButton = false
                    });
            }

        }
    }
