    {
        StateHasChanged();
        // Inicializa las secciones y datos de ejemplo
        CalificacionesData = await calificacionesService.GetDatafromFuntionCalificaciones();
        cal_data_filtered = CalificacionesData.Where(c => c.cur_id == 1 && c.asig_id == 1).ToList();
