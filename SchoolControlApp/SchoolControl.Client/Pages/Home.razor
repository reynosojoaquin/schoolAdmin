@page "/"
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Components.Authorization;
@using SchoolControl.Client.Extensiones;
@inject AutenticationExtension AuthStateProvider;
@attribute [Authorize]
<PageTitle>Home</PageTitle>
<AuthorizeView>
    <Authorized>
        

        Bienvenido al sistema administrativo del Liceo Coronel Rafael Tomas Fernandez Dominguez
        <h3> @userName</h3>
    </Authorized>
</AuthorizeView>
@code {
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      //  userName = authState.User.Identity?.Name ?? "Guest";
        userName = authState.User.FindFirst("fullName")?.Value ?? "Guest";
    }
}
