@page  "/ListaPermisos"

@using SchoolControl.Shared;
@using SchoolControl.Client.Services;
@using CurrieTechnologies.Razor.SweetAlert2;

@inject SweetAlertService Swal;
@inject IRolesService RolesServices;
@inject IUserService UserService;
@inject NavigationManager NavigationManager
<div class="card mt-12">
    <div class="card-header">
        <h3 class="card-title">Roles</h3>
    </div>
    <div class="card-body">
        <input type="text" @bind-value="searchTerm" @onkeypress="OnKeyPress" id="filterInput" class="form-control mb-2" placeholder="Filtrar Permisos...">

        <table class="table table-striped  ">
            <thead>
            <th>Id</th>
            <th>Descripcion</th>
            <th>Acciones</th>
            </thead>
            <tbody>
                @if (ListRoles == null)
                {
                    <tr>
                        <td colspan="5" align="center">
                            <img style="with:50px" src="https://media.tenor.com/2BLI5EO7yVAAAAAi/loading-image.gif" />
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in ListRoles)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.NombreRol</td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="(()=> filtrarPermisos(item.Id))">
                                    <i class="fas fa-edit"></i>&nbsp Editar
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="(()=> eliminar(item.Id))">
                                    <i class="fas fa-trash-alt"></i>&nbspEliminar
                                </button>
                             </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>

<!--card for the permittion data -->
 
<div class="card mt-12">
    <div class="card-header">
        <h3 class="card-title">Permisos </h3>
    </div>
    <div class="card-body">
        <div class="container mt-2">
        </div>
        <div class="card mt-12">
            <div class="card-header">
                <h3 class="card-title"> <h3>Permisos para el rol</h3></h3>
            </div>
            <div class="card-body">
                <ul>
                    @foreach (var role in ListPermisosSistemaFiltered)
                    {
                        <li>
                            <b>@role.rolName</b>
                            <ul>
                                @foreach (var permission in role.Permisos)
                                {
                                    <li>

                                        <input type="checkbox" @bind="permission.Activo" @bind:after="() => TogglePermission(permission.Id)" />
                                        @permission.Descripcion
                                        <ul>
                                            @foreach (var action in permission.Acciones)
                                            {
                                                <li>

                                                    <input type="checkbox" @bind="action.Activa" @bind:after="() => ToggleAction(action.id.GetValueOrDefault())" />
                                                    @action.Descripcion
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
      
    </div>
   <div class="row">
        <div class="col-2 text-center">
            <button class="btn mb-2  btn-primary" @onclick="(()=> Guardar())">
                <i class="fas fa-floppy-disk"></i>&nbspGuardar
            </button>
        </div>
        <div class="col-9"></div>
   </div>
</div>



@code {

    [Parameter]
    public int? user_id  { get; set; } =0;
    public bool showFirstPage { get; set; }

