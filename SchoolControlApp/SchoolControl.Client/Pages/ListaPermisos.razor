    public EventCallback<string> OnValueSentBack { get; set; }

    public string searchTerm = string.Empty;
    List<RoleDto>? ListRoles = null;
    List<PermisosSistemaDTO> ListPermisosSistema = new List<PermisosSistemaDTO>();
    List<PermisosSistemaDTO> ListPermisosSistemaFiltered = new List<PermisosSistemaDTO>();
    PermisosSistemaDTO selectedPermiso = new PermisosSistemaDTO();
    private HashSet<int> SelectedPermissionIds { get; set; } = new();
    private HashSet<int> SelectedActionIds { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        ListRoles = await RolesServices.GetRoles();
        ListPermisosSistema = await UserService.getSystemPermission();
    }

    private async Task  FiltrarRoles()
    {
        // ListaCursos = await CursoServices.GetCountryFiltered(searchTerm);
    }
    private void filtrarPermisos(int permisoID)
    {

        ListPermisosSistemaFiltered = ListPermisosSistema.Where(r => r.id == permisoID).ToList();
    }
    private void TogglePermission(int permissionId)
    {
        if (SelectedPermissionIds.Contains(permissionId))
        {
            SelectedPermissionIds.Remove(permissionId);
        }
        else
        {
            SelectedPermissionIds.Add(permissionId);
        }
    }

    private void ToggleAction(int actionId)
    {
        if (SelectedActionIds.Contains(actionId))
        {
            SelectedActionIds.Remove(actionId);
        }
        else
        {
            SelectedActionIds.Add(actionId);
        }
    }
    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        // Filtrar cuando se presione "Enter"
        if (e.Key == "Enter")
        {
            await FiltrarRoles();
        }
    }
    private async Task eliminar(int id)
    {
