@page  "/ListaEmpleados"
@using SchoolControl.Shared;
@using SchoolControl.Client.Services;
@using CurrieTechnologies.Razor.SweetAlert2;

@inject SweetAlertService Swal;
@inject IDocentesServices DocentesServices;
@inject NavigationManager NavigationManager
<div class="card mt-6">
    <div class="card-header">
        <h3 class="card-title">LISTADO DE EMPLEADOS</h3>
    </div>
    <div class="card-body">
        <div class="container mt-2">
            <!-- Fila para el filtro y el botón -->
            <div class="row mb-1">
                <div class="col-md-4 text-start">

                    <button class="btn btn-primary" @onclick="()=> showCreatePage(0)">
                        <i class="fas fa-plus"></i> CREAR EMPLEADO
                    </button>
                </div>
                <div class="col-md-8">
                    <!-- Campo para filtrar datos -->
                    <input type="text" @bind-value="searchTerm" @onkeypress="OnKeyPress" id="filterInput" class="form-control" placeholder="Filtrar Asignaturas...">
                </div>

            </div>
        </div>

        <table class="table table-striped  ">
            <thead>
                <th>Id</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </thead>
            <tbody>
                @if (ListaAsignatura == null)
                {
                    <tr>
                        <td colspan="5" align="center">
                            <img style="with:50px" src="https://media.tenor.com/2BLI5EO7yVAAAAAi/loading-image.gif" />
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in ListaAsignatura)
                    {
                        <tr>
                            <td>@item.id</td>
                            <td>@item.Nombre</td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="(()=> Modificar(item.id))" href="addProvincia/@item.id">
                                    <i class="fas fa-edit"></i>&nbsp Editar
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="(()=> eliminar(item.id))">
                                    <i class="fas fa-trash-alt"></i>&nbspEliminar
                                </button>
                                <button class="btn btn-sm btn-success" @onclick="(()=> mostrarEstudiantes(item.CursoID.GetValueOrDefault()))">
                                    <i class="fas  fa-users"></i>&nbspEstudiantes
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>




@code {
    [Parameter]
    public string parametros { get; set; } ="";
    [Parameter]
    public int? curso_id  { get; set; } =0;
    public int responsable { get; set; } = 0;
    public int? asignatura_id { get; set; }
    [Parameter]
    public bool showFirstPage { get; set; }
    [Parameter]
    public EventCallback<string> OnValueSentBack { get; set; }
   
    public string searchTerm = string.Empty;
    List<asignaturaDTO>? ListaAsignatura = null;
    public asignaturaDTO CurrentAsignatura = null; 

    protected override async Task OnInitializedAsync()
    {
        // CurrentAsignatura = await AsignaturaServices.;
      //  curso_id = CurrentAsignatura.CursoID;
        
        curso_id = Convert.ToInt32(parametros.Split(",")[0]);
        responsable = Convert.ToInt32(parametros.Split(",")[1]);
      //  ListaAsignatura = await AsignaturaServices.getAsignaturaTeachers( Convert.ToInt32(curso_id),Convert.ToInt32(responsable));
    }

    private async Task  FiltrarAsignaturas()
    {
        // ListaCursos = await CursoServices.GetCountryFiltered(searchTerm);
    }
    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        // Filtrar cuando se presione "Enter"
        if (e.Key == "Enter")
        {
            await FiltrarAsignaturas();
        }
    }
    private async Task eliminar(int id)
    {
        var resultado = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Eliminar Asignatura",
                Text = "Deseas eliminar el Asignatura",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (resultado.IsConfirmed)
        {
            var eliminado = false;
            if (eliminado)
                ListaAsignatura = ListaAsignatura.FindAll(e => e.id != id);
        }
    }
    private async Task Modificar(int id)
    {
        showCreatePage(id);
    }
    public void showCreatePage(int value)
    {
        SendBackValue("true,p," + Convert.ToString(value));
    }
    public void SendBackValue(string value)
    {
        OnValueSentBack.InvokeAsync(value);
    }
    private void mostrarEstudiantes(int CursoID)
    {
        string parametros = "";
        NavigationManager.NavigateTo($"/ListaEstudiantes/{CursoID}");
    }


}
<style>
     .col-id {
        width: 100px; /* Ajusta este valor según el tamaño del contenido de la columna Id */
        text-align: center;
    }

    .col-nombre {
        width: 1px; /* Ajuste inicial para que tome el espacio restante */
        white-space: nowrap; /* Evita el ajuste de línea en el contenido */
    }
</style>