DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Use False solamente mientras el servidor interno funcione sin HTTPS.
DJANGO_SECURE_COOKIES=False

# Leave empty to use SQLite locally.
# Example PostgreSQL:
# DATABASE_URL=postgres://school_user:school_password@localhost:5432/school_admin_lite
DATABASE_URL=

# Asistente local de horarios (Ollama o API compatible dentro de la red local).
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b
